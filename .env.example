# NEBANK — environment. Copy to .env and fill BOT_TOKEN. Everything else has
# working defaults for this server (104.194.143.122 / 104-194-143-122.sslip.io).

# REQUIRED — token of @nebanknebot from BotFather:
BOT_TOKEN=

# Public address of the Mini App (HTTPS, auto-provisioned by Caddy):
PUBLIC_BASE_URL=https://104-194-143-122.sslip.io
BOT_USERNAME=nebanknebot

# Webhook secret (any random string; already set):
WEBHOOK_SECRET=nebank-7f3a91c4e2
USE_WEBHOOK=true

# Database (compose injects DATABASE_URL; this only sets the password):
POSTGRES_PASSWORD=nebank_8e21d5c7

# Monetization:
PREMIUM_PRICE_STARS=250
PREMIUM_PERIOD_DAYS=30

# --- Optional AI upgrades (the app works fully without these) ---
# Voice transcription. "faster_whisper" (local, needs the package+model) or
# "whisper_api" (OpenAI-compatible). Leave as-is to disable gracefully.
VOICE_PROVIDER=whisper_api
WHISPER_API_BASE=https://api.openai.com/v1
WHISPER_API_KEY=
# Photo recognition. With a vision-capable LLM key here, receipts / screenshots /
# bank-app captures are read by a vision model — dramatically better than the free
# built-in Tesseract OCR (which stays as the no-key fallback). LLM_MODEL must be
# vision-capable (gpt-4o-mini is). Cost is a fraction of a cent per photo.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
